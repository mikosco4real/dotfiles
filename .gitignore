# Neovim runtime artifacts. nvim writes these into its own config dir, which is
# the folded symlink target — so they land here. They must never be committed,
# and must never be visible to chezmoi as source state.
nvim-pack-lock.json
lazy-lock.json

# macOS
.DS_Store

