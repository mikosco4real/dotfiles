<?xml version="1.0" encoding="UTF-8"?>
<!--
  Daily report draft: weekdays at 16:45, `hub report` (notify mode) writes
  ~/.local/state/hub/reports/<date>.md and posts a notification. It never
  touches the clipboard (that would clobber whatever you copied last);
  `hub report show` prints the draft and copies it when you are ready to paste
  it into Teams.

  Same gating as the dispatcher plist: only where hubDispatcher = true, so a
  workspace gets one scheduled draft, not one per machine. `hub report` works
  by hand anywhere.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.dotfiles.hub-report</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{ .chezmoi.homeDir }}/.local/bin/hub</string>
    <string>report</string>
    <string>--notify</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
{{- range $day := list 1 2 3 4 5 }}
    <dict>
      <key>Weekday</key>
      <integer>{{ $day }}</integer>
      <key>Hour</key>
      <integer>16</integer>
      <key>Minute</key>
      <integer>45</integer>
    </dict>
{{- end }}
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>{{ .chezmoi.homeDir }}/.local/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StandardOutPath</key>
  <string>{{ .chezmoi.homeDir }}/.local/state/hub/launchd-report.log</string>
  <key>StandardErrorPath</key>
  <string>{{ .chezmoi.homeDir }}/.local/state/hub/launchd-report.log</string>
</dict>
</plist>
