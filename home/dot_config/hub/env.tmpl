# ~/.config/hub/env — rendered by chezmoi from home/dot_config/hub/env.tmpl.
#
# Identity of THIS machine's beads hub, sourced by ~/.local/bin/bdh and
# ~/.local/bin/hub. It is a template, so it is a real file, not a symlink:
# editing it here is pointless, because the next `chezmoi apply` overwrites it.
#
# Overrides (dispatcher budget, hours, repo roots) go in ~/.config/hub/env.local,
# which is sourced after this file and never managed. See `hub help`.
{{- $hubRemote := get . "hubRemote" | default "" }}

HUB_WORKSPACE={{ .machineClass | quote }}
HUB_DIR="$HOME/hub"
HUB_REMOTE={{ $hubRemote | quote }}
# Issue prefix, used once by `hub init`: w-123 is work, p-123 is personal.
HUB_PREFIX={{ if eq .machineClass "work" }}"w"{{ else }}"p"{{ end }}
# GitHub owner the daily report searches for merged PRs; empty = all of them.
HUB_GH_OWNER={{ if eq .machineClass "work" }}{{ .workOrg | quote }}{{ else }}""{{ end }}
# Where local clones live, for mapping a bead's repo:<owner>/<name> label to a
# directory. Space-separated.
HUB_REPO_ROOTS="$HOME/Projects"
