# Linux/GTK-only Ghostty settings. Pulled in by `config-file = ?config.linux`.
# chezmoi does not deploy this file on macOS (see home/.chezmoiignore).

# kitty's `tab_bar_edge bottom`. GTK-only — macOS uses native titlebar tabs.
# (kitty's `tab_bar_min_tabs 2` needs no equivalent: window-show-tab-bar
# defaults to `auto`, which already hides the bar below two tabs.)
gtk-tabs-location = bottom

# Match macOS behaviour. The Linux default here is the opposite (true).
quit-after-last-window-closed = false

# ─── Keybindings ──────────────────────────────────────────────────────────────
# `super` does map to the Super/Windows key on Linux, but GNOME and KDE grab it
# at the compositor, so super+<key> never reaches the terminal. ctrl+shift is the
# idiomatic Linux modifier and is what Ghostty's own Linux defaults use for
# copy/paste/new-tab, with alt+N for tab switching.

# Line start / end, mirroring the macOS Cmd+Arrow muscle memory.
# \x01 = Ctrl-A (start of line), \x05 = Ctrl-E (end of line).
keybind = ctrl+shift+arrow_left=text:\x01
keybind = ctrl+shift+arrow_right=text:\x05

# Tab navigation, mirroring super+k / super+h on macOS.
keybind = performable:ctrl+shift+k=next_tab
keybind = performable:ctrl+shift+h=previous_tab

# alt+1..8 are already goto_tab:1..8 on Linux; alt+9 defaults to last_tab.
keybind = alt+9=goto_tab:9

# Optional: colour the GTK titlebar from the terminal background. Linux-only
# value, and a good pairing with Catppuccin.
# window-theme = ghostty
