#!/usr/bin/env bash
# bdh — run bd against this machine's beads hub, from any directory.
#
# BEADS_DIR is set for THIS process only. Never export it from a shell rc: an
# exported BEADS_DIR overrides discovery everywhere, so a repo that later gets
# its own .beads/ would silently read and write the hub instead.
#
# Before running, pull the hub at most once every BDH_PULL_MINUTES (default 15)
# so a machine picks up beads written elsewhere. A failed pull (offline, auth)
# is not fatal: bd still runs against the local copy. BDH_NO_PULL=1 skips it.
# Pushes need no help: the hub sets dolt.auto-push in .beads/config.yaml.
set -euo pipefail

HUB_ENV="${HUB_ENV:-${XDG_CONFIG_HOME:-$HOME/.config}/hub/env}"
# shellcheck source=/dev/null
[[ -r "$HUB_ENV" ]] && source "$HUB_ENV"
# shellcheck source=/dev/null
[[ -r "$HUB_ENV.local" ]] && source "$HUB_ENV.local"
HUB_DIR="${HUB_DIR:-$HOME/hub}"

if [[ ! -d "$HUB_DIR/.beads" ]]; then
  echo "bdh: no hub at $HUB_DIR. Create one with \`hub init\`, or set hubRemote and run \`chezmoi apply --init\`." >&2
  exit 1
fi
export BEADS_DIR="$HUB_DIR/.beads"

# bd reads beads.role from the CURRENT directory's git config, so outside ~/hub
# every command warns "beads.role not configured". Inject it for this process
# only via git's env-config; setting it with --global would also apply to any
# team repo that adopts beads later, where the right role may be contributor.
_n=${GIT_CONFIG_COUNT:-0}
export "GIT_CONFIG_KEY_$_n=beads.role" "GIT_CONFIG_VALUE_$_n=maintainer" GIT_CONFIG_COUNT=$((_n + 1))

stamp="${XDG_CACHE_HOME:-$HOME/.cache}/hub/last-pull"
if [[ -z "${BDH_NO_PULL:-}" ]] &&
  { [[ ! -e "$stamp" ]] || [[ -n "$(find "$stamp" -mmin +"${BDH_PULL_MINUTES:-15}" 2> /dev/null)" ]]; }; then
  mkdir -p "${stamp%/*}"
  # Touch first, so a slow or failing remote is retried on the next interval
  # rather than on every single command.
  touch "$stamp"
  bd dolt pull > /dev/null 2>&1 || echo "bdh: pull failed; using the local copy" >&2
fi

# Tracker sync is two-way by default: `bd github sync` would push every hub
# bead (did logs and to-dos included) into one repo as issues, and its pull
# imports a repo's entire history. Selected issues come in via `hub issue`.
case "${1:-} ${2:-}" in
  "github sync" | "github push" | "gitlab sync" | "gitlab push" | "jira sync" | "jira push" | "linear sync" | "linear push")
    if [[ -z "${BDH_ALLOW_TRACKER_SYNC:-}" ]]; then
      echo "bdh: refusing \`bd $1 $2\` on the hub: it is two-way by default and would push every bead to one repo." >&2
      echo "     Import selected issues with \`hub issue <url>\` or \`hub issues --import\`. Override: BDH_ALLOW_TRACKER_SYNC=1" >&2
      exit 2
    fi
    ;;
esac

exec bd "$@"
