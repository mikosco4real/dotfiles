#!/usr/bin/env bash
# hub — the beads hub toolkit. `hub help` for usage; CLAUDE.md, "beads hub",
# for the design. Plain bash so it also runs under launchd, which reads no
# shell rc files: everything it needs comes from ~/.config/hub/env.
set -euo pipefail

HUB_ENV="${HUB_ENV:-${XDG_CONFIG_HOME:-$HOME/.config}/hub/env}"
# shellcheck source=/dev/null
[[ -r "$HUB_ENV" ]] && source "$HUB_ENV"
# shellcheck source=/dev/null
[[ -r "$HUB_ENV.local" ]] && source "$HUB_ENV.local"

HUB_DIR="${HUB_DIR:-$HOME/hub}"
HUB_REMOTE="${HUB_REMOTE:-}"
HUB_PREFIX="${HUB_PREFIX:-p}"
HUB_GH_OWNER="${HUB_GH_OWNER:-}"
HUB_REPO_ROOTS="${HUB_REPO_ROOTS:-$HOME/Projects}"
HUB_TEMPLATE="${HUB_TEMPLATE:-${XDG_CONFIG_HOME:-$HOME/.config}/hub/report-template.md}"

# Guardrails. Override any of these in ~/.config/hub/env.local. On a claude.ai
# subscription nothing is billed per run; the dollar figures are Claude Code's
# own cost ESTIMATE and cap how much of your usage allowance one run may use.
: "${HUB_DISPATCH_BUDGET_USD:=3}"  # per dispatcher run
: "${HUB_DISPATCH_MAX_RUNS:=6}"    # dispatcher runs that reach claude, per day
: "${HUB_DISPATCH_MAX_TURNS:=200}" # per dispatcher run
: "${HUB_DISPATCH_BATCH:=3}"       # beads handed to one run
: "${HUB_DISPATCH_HOURS:=08-18}"   # local hours, start inclusive, end exclusive
: "${HUB_DISPATCH_DAYS:=1-5}"      # ISO weekdays, 1 = Monday
: "${HUB_REPORT_BUDGET_USD:=0.25}" # per report polish
: "${HUB_CLOUD_STALE_HOURS:=2}"    # a cloud session with no PR after this is flagged

STATE="${XDG_STATE_HOME:-$HOME/.local/state}/hub"
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/hub"
LAUNCHD_DISPATCH="dev.dotfiles.hub-dispatch"

# bd reads beads.role from the current directory's git config; scope it to this
# process (and the bdh/claude children it starts) instead of --global. See bdh.
_n=${GIT_CONFIG_COUNT:-0}
export "GIT_CONFIG_KEY_$_n=beads.role" "GIT_CONFIG_VALUE_$_n=maintainer" GIT_CONFIG_COUNT=$((_n + 1))

log() { printf '\033[1;34m==>\033[0m %s\n' "$*" >&2; }
die() {
  printf 'hub: %s\n' "$*" >&2
  exit 1
}

# bd against the hub, without bdh's opportunistic pull: every caller here pulls
# explicitly, once, at a point where it matters.
hbd() { BEADS_DIR="$HUB_DIR/.beads" bd "$@"; }

# launchd starts jobs with a bare PATH. claude and gh are installed by mise, bd
# and jq by Homebrew, so bring both in when they are not already resolvable.
ensure_path() {
  local b
  if ! command -v bd > /dev/null 2>&1 || ! command -v jq > /dev/null 2>&1; then
    for b in /opt/homebrew/bin/brew /usr/local/bin/brew /home/linuxbrew/.linuxbrew/bin/brew; do
      [[ -x "$b" ]] && eval "$("$b" shellenv)" && break
    done
  fi
  PATH="$HOME/.local/bin:$PATH"
  if ! command -v claude > /dev/null 2>&1 || ! command -v gh > /dev/null 2>&1; then
    command -v mise > /dev/null 2>&1 && eval "$(mise env -s bash 2> /dev/null)"
  fi
  export PATH
}

need() {
  local t
  for t in "$@"; do command -v "$t" > /dev/null 2>&1 || die "$t not found on PATH"; done
}

need_hub() {
  [[ -d "$HUB_DIR/.beads" ]] || die "no hub at $HUB_DIR (\`hub init\` creates one; \`hub bootstrap\` clones it)"
}

notify() {
  if command -v osascript > /dev/null 2>&1; then
    osascript -e "display notification \"${2//\"/\'}\" with title \"${1//\"/\'}\"" > /dev/null 2>&1 || true
  elif command -v notify-send > /dev/null 2>&1; then
    notify-send "$1" "$2" || true
  fi
}

# owner/name, lower-cased, from git@host:owner/name.git or https://host/owner/name.
slug_of() {
  local u="${1%.git}" name
  u="${u//://}"
  name="${u##*/}"
  u="${u%/*}"
  printf '%s/%s\n' "${u##*/}" "$name" | tr '[:upper:]' '[:lower:]'
}

# The Dolt remote URL for a git remote: git@github.com:o/r.git -> git+ssh://git@github.com/o/r.git
dolt_url_of() {
  case "$1" in
    git@*:*) printf 'git+ssh://%s/%s\n' "${1%%:*}" "${1#*:}" ;;
    https://*) printf 'git+%s\n' "$1" ;;
    *) printf '%s\n' "$1" ;;
  esac
}

# `date` differs between BSD (macOS) and GNU (Linux); -j exists only on BSD.
is_bsd_date() { date -j > /dev/null 2>&1; }

# RFC3339 for local midnight at the start of $1 (YYYY-MM-DD). bd stores
# closed_at in UTC, and a bare date is ambiguous, so pass the offset.
day_start() {
  local z
  if is_bsd_date; then z=$(date -j -f '%F %T' "$1 00:00:00" +%z); else z=$(date -d "$1 00:00:00" +%z); fi
  printf '%sT00:00:00%s:%s\n' "$1" "${z:0:3}" "${z:3:2}"
}

next_day() {
  if is_bsd_date; then date -j -v+1d -f '%F' "$1" +%F; else date -d "$1 +1 day" +%F; fi
}

telemetry_off() {
  bd metrics off > /dev/null 2>&1 || true
  if command -v dolt > /dev/null 2>&1 && ! dolt config --global --get metrics.disabled > /dev/null 2>&1; then
    dolt config --global --add metrics.disabled true > /dev/null 2>&1 || true
  fi
}

# ─── init: create the hub (once per workspace, ever) ──────────────────────────
cmd_init() {
  ensure_path
  need git gh bd
  [[ -n "$HUB_REMOTE" ]] || die "hubRemote is blank on this machine; set it with \`chezmoi init\` (or \`make update\`) first"
  [[ ! -e "$HUB_DIR" ]] || die "$HUB_DIR already exists"
  local slug
  slug=$(slug_of "$HUB_REMOTE")
  if gh repo view "$slug" > /dev/null 2>&1; then
    die "$slug already exists on GitHub. Clone it instead: hub bootstrap"
  fi

  printf 'Create a PRIVATE GitHub repo %s and a new %s hub at %s? [y/N] ' "$slug" "${HUB_WORKSPACE:-?}" "$HUB_DIR"
  local answer
  read -r answer
  [[ "$answer" == [yY]* ]] || die "aborted"

  mkdir -p "$HUB_DIR"
  cd "$HUB_DIR"
  git init -q -b main
  git remote add origin "$HUB_REMOTE"
  # Silences bd's "beads.role not configured" warning on every command. The
  # hub is private and single-owner, so this machine maintains it.
  git config beads.role maintainer

  bd init --prefix "$HUB_PREFIX" --skip-agents
  chmod 700 .beads
  bd config set dolt.auto-push true > /dev/null
  bd dolt remote list 2> /dev/null | grep -q '^origin' ||
    bd dolt remote add origin "$(dolt_url_of "$HUB_REMOTE")" > /dev/null

  cat > CLAUDE.md << EOF
# Beads hub — ${HUB_WORKSPACE:-unknown} workspace

This repo holds no code. It is the beads work graph for the
${HUB_WORKSPACE:-unknown} workspace, synced through \`refs/dolt/data\` on this
repo's remote. Anyone who can read that remote can read every bead, so never
write secrets or message bodies into one.

**Load the \`hub\` skill before acting on any request in this repo.** It holds
the labels, the claim → brief → close protocol, tier escalation notes, gates
and dispatch mode. Don't restate them here; the skill is the single source.
EOF
  # Project-scoped SessionStart hook (bd prime) + bd's managed CLAUDE.md block.
  # Never --global: bd prime would then inject 1-2k tokens into every session.
  bd setup claude > /dev/null
  # .beads.gate.lock is a runtime lock bd drops at the repo root;
  # .beads/issues.jsonl is the export beads_viewer (`hub ui`) regenerates.
  printf '.claude/settings.local.json\n.beads.gate.lock\n.beads/issues.jsonl\n' > .gitignore

  telemetry_off
  git add -A
  git commit -q -m "Initialise beads hub (${HUB_WORKSPACE:-unknown})"
  # Not --source/--push: those try to add an `origin` remote, which already
  # exists (bd init needed it to configure the Dolt remote), and then fail.
  gh repo create "$slug" --private > /dev/null
  git push -q -u origin main
  bd dolt push
  log "hub ready at $HUB_DIR. Other machines: \`chezmoi apply\` (or \`hub bootstrap\`)."
}

# ─── bootstrap: clone an existing hub onto this machine ───────────────────────
cmd_bootstrap() {
  ensure_path
  need git bd
  if [[ -z "$HUB_REMOTE" ]]; then
    log "no hubRemote on this machine; nothing to bootstrap"
    return 0
  fi
  if [[ -d "$HUB_DIR/.git" ]]; then
    log "hub already present at $HUB_DIR"
    return 0
  fi
  [[ ! -e "$HUB_DIR" ]] || die "$HUB_DIR exists but is not a git repo; move it aside first"

  if ! git ls-remote "$HUB_REMOTE" > /dev/null 2>&1; then
    log "cannot reach $HUB_REMOTE (not created yet, or no access). Create it once with \`hub init\`, then run \`hub bootstrap\`."
    return 0
  fi
  # bd bootstrap silently creates an EMPTY database when the remote has no
  # beads data, which would then be pushed over the real one later. Refuse.
  if ! git ls-remote "$HUB_REMOTE" refs/dolt/data | grep -q .; then
    log "$HUB_REMOTE has no refs/dolt/data yet; finish \`hub init\` (bd dolt push) on the first machine"
    return 0
  fi

  git clone -q "$HUB_REMOTE" "$HUB_DIR"
  chmod 700 "$HUB_DIR/.beads"
  git -C "$HUB_DIR" config beads.role maintainer
  (cd "$HUB_DIR" && bd bootstrap)
  telemetry_off
  log "hub cloned to $HUB_DIR"
}

# ─── report: the daily summary draft ──────────────────────────────────────────
copy_clipboard() {
  if command -v pbcopy > /dev/null 2>&1; then
    pbcopy
  elif command -v wl-copy > /dev/null 2>&1; then
    wl-copy
  elif command -v xclip > /dev/null 2>&1; then
    xclip -selection clipboard
  else
    cat > /dev/null
    return 1
  fi
}

cmd_report() {
  ensure_path
  local raw="" day notify_only="" out
  day=$(date +%F)
  if [[ "${1:-}" == "show" ]]; then
    out=$(find "$STATE/reports" -name '*.md' 2> /dev/null | sort | tail -1)
    [[ -n "$out" ]] || die "no reports yet; run \`hub report\`"
    cat "$out"
    copy_clipboard < "$out" && log "copied $(basename "$out") to the clipboard"
    return 0
  fi
  while (($#)); do
    case "$1" in
      --raw) raw=1 ;;
      --date)
        day="${2:?--date needs YYYY-MM-DD}"
        shift
        ;;
      --notify) notify_only=1 ;;
      *) die "report: unknown option $1" ;;
    esac
    shift
  done
  need bd jq
  need_hub

  hbd dolt pull > /dev/null 2>&1 || log "pull failed; reporting from the local copy"
  local from to closed wip blocked todos cloudwait prs md
  from=$(day_start "$day")
  to=$(day_start "$(next_day "$day")")
  closed=$(hbd list -s closed --closed-after "$from" --closed-before "$to" -n 0 --json 2> /dev/null || echo '[]')
  wip=$(hbd list -s in_progress -n 0 --json 2> /dev/null || echo '[]')
  blocked=$(hbd blocked --json 2> /dev/null || echo '[]')
  todos=$(hbd list -l human -n 0 --json 2> /dev/null || echo '[]')
  cloudwait=$(hbd list -l cloud -s open -n 0 --json 2> /dev/null || echo '[]')
  prs='[]'
  if command -v gh > /dev/null 2>&1; then
    # macOS ships bash 3.2, where "${arr[@]}" of an EMPTY array is an unbound-
    # variable error under set -u. The ${arr[@]+...} form expands to nothing.
    local owner_flag=()
    [[ -n "$HUB_GH_OWNER" ]] && owner_flag=(--owner "$HUB_GH_OWNER")
    prs=$(gh search prs --author=@me --merged="$from..$to" ${owner_flag[@]+"${owner_flag[@]}"} \
      --json title,url,repository --limit 100 2> /dev/null || echo '[]')
  fi

  md=$(jq -nr --arg day "$day" \
    --argjson closed "${closed:-[]}" --argjson wip "${wip:-[]}" \
    --argjson blocked "${blocked:-[]}" --argjson todos "${todos:-[]}" --argjson prs "${prs:-[]}" \
    --argjson cloudwait "${cloudwait:-[]}" '
    def repo: ((.labels // []) | map(select(startswith("repo:"))) | first // "repo:(no repo)") | ltrimstr("repo:");
    def who: if ((.labels // []) | index("manual")) then "" else " _(agent)_" end;
    def section(title; items; fmt):
      if (items | length) == 0 then empty else "\n## \(title)\n", (items | .[] | fmt) end;
    "# Work summary — \($day)",
    section("Done"; ($closed | map(select(.issue_type != "gate")) | sort_by(repo));
      "- [\(repo)] \(.title)\(who)\(if (.close_reason // "") | test("^https?://|PR") then " — \(.close_reason)" else "" end)"),
    section("PRs merged"; $prs; "- [\(.repository.nameWithOwner)] \(.title) — \(.url)"),
    section("In progress"; $wip; "- [\(repo)] \(.title)"),
    section("Blocked"; $blocked; "- [\(repo)] \(.title) — blocked by \(.blocked_by | join(", "))"),
    section("My to-dos"; $todos; "- \(.title)"),
    section("Waiting to launch in the cloud"; $cloudwait; "- [\(repo)] \(.title) — hub cloud \(.id)")
  ')

  mkdir -p "$STATE/reports"
  out="$STATE/reports/$day.md"
  if [[ -z "$raw" ]] && ! command -v claude > /dev/null 2>&1; then
    log "claude not on PATH; saving the raw summary"
    raw=1
  elif [[ -z "$raw" && ! -r "$HUB_TEMPLATE" ]]; then
    log "no report template at $HUB_TEMPLATE; saving the raw summary"
    raw=1
  fi
  if [[ -n "$raw" ]]; then
    printf '%s\n' "$md" > "$out"
  else
    # No tools, no MCP servers, nothing to approve: this run only rewrites text.
    # Run from $STATE so no project hook (e.g. the hub's bd prime) fires.
    (cd "$STATE" && printf '%s\n' "$md" | claude -p --model sonnet --tools "" \
      --strict-mcp-config --max-budget-usd "$HUB_REPORT_BUDGET_USD" \
      --append-system-prompt "$(cat "$HUB_TEMPLATE")" \
      "Rewrite the work summary on stdin as my daily update, following the system instructions.") > "$out" ||
      {
        log "polish failed; saved the raw summary instead"
        printf '%s\n' "$md" > "$out"
      }
  fi

  if [[ -n "$notify_only" ]]; then
    notify "Daily report ready" "hub report show — prints it and copies it to the clipboard"
  else
    cat "$out"
    log "saved $out — \`hub report show\` copies it to the clipboard"
  fi
}

# ─── issues: selected GitHub issues into the hub ──────────────────────────────
# Deliberately NOT `bd github sync`. That is two-way by default (it would push
# every hub bead, did logs and to-dos included, into one repo as issues),
# handles one repo per config, imports a repo's whole history (46 beads for one
# open issue, when tried), adds no repo: label, and wants its token stored in
# the synced database. This imports exactly the issues you pick, one bead each.

# https://github.com/o/r/issues/N or o/r#N  ->  https://github.com/o/r/issues/N
issue_url_of() {
  case "$1" in
    https://github.com/*/*/issues/*) printf '%s\n' "${1%%[?#]*}" ;;
    */*#*) printf 'https://github.com/%s/issues/%s\n' "${1%%#*}" "${1##*#}" ;;
    *) return 1 ;;
  esac
}

# Import one issue. $1 = URL, $2 = "agent-ok" to also queue it for dispatch.
import_issue() {
  local url="$1" extra="${2:-}" existing data state slug labels id
  existing=$(hbd list --all -n 0 --external-ref "$url" --json 2> /dev/null | jq -r '.[0].id // empty')
  if [[ -n "$existing" ]]; then
    if [[ "$extra" == "agent-ok" ]]; then
      hbd update "$existing" --add-label agent-ok > /dev/null
      log "$existing already in the hub; labelled agent-ok"
    else
      log "$existing already in the hub ($url)"
    fi
    return 0
  fi
  data=$(gh issue view "$url" --json number,title,body,state,labels) || {
    log "cannot read $url (no access, or not an issue)"
    return 1
  }
  state=$(jq -r .state <<< "$data")
  if [[ "$state" != "OPEN" ]]; then
    log "$url is $state; not importing"
    return 0
  fi
  slug=$(slug_of "${url%/issues/*}")
  # GitHub labels are copied ONLY with a gh: prefix. Copied verbatim, anyone
  # able to label an issue could add agent-ok (or human) and steer the hub.
  labels=$(jq -r --arg s "$slug" --arg x "$extra" '
    ["repo:" + $s, "gh-issue"] + (if $x == "" then [] else [$x] end)
    + [.labels[].name | "gh:" + (ascii_downcase | gsub("[^a-z0-9._-]+"; "-"))]
    | unique | join(",")' <<< "$data")
  id=$(hbd create "$(jq -r .title <<< "$data")" \
    -t "$(jq -r 'if any(.labels[].name; ascii_downcase == "bug") then "bug" else "task" end' <<< "$data")" \
    -l "$labels" --external-ref "$url" \
    -d "$(jq -r --arg u "$url" '"Imported from \($u)\n\n" + ((.body // "") | if length > 6000 then .[0:6000] + "\n\n[truncated; full text on GitHub]" else . end)' <<< "$data")" \
    --silent)
  log "imported $id  $(jq -r .title <<< "$data")  ($slug#$(jq -r .number <<< "$data"))"
}

cmd_issue() {
  ensure_path
  need gh jq bd
  need_hub
  local ref="" extra="" url
  while (($#)); do
    case "$1" in
      --agent-ok) extra=agent-ok ;;
      -*) die "issue: unknown option $1" ;;
      *) ref="$1" ;;
    esac
    shift
  done
  [[ -n "$ref" ]] || die "usage: hub issue <issue URL | owner/repo#N> [--agent-ok]"
  url=$(issue_url_of "$ref") || die "not a GitHub issue reference: $ref"
  import_issue "$url" "$extra"
}

# Open issues assigned to you (in HUB_GH_OWNER when set) that are not in the
# hub yet. Prints them; --import brings them all in (never with agent-ok).
issues_assigned() {
  local do_import="$1" owner_flag=() found refs
  [[ -n "$HUB_GH_OWNER" ]] && owner_flag=(--owner "$HUB_GH_OWNER")
  found=$(gh search issues --assignee=@me --state=open ${owner_flag[@]+"${owner_flag[@]}"} \
    --json url,title,repository --limit 100) || return 1
  refs=$(hbd list --all -n 0 --json 2> /dev/null | jq -c '[.[].external_ref // empty]')
  jq -r --argjson have "$refs" '.[] | select(.url as $u | $have | index($u) | not) | .url' <<< "$found" |
    while read -r url; do
      if [[ -n "$do_import" ]]; then
        import_issue "$url" || true
      else
        jq -r --arg u "$url" '.[] | select(.url == $u) | "  new  \(.repository.nameWithOwner)#\(.url | split("/") | last)  \(.title)"' <<< "$found"
      fi
    done
}

# Close open gh-issue beads whose issue was closed on GitHub (fixed elsewhere,
# or merged via a PR that said "Closes …"). In-progress beads are left alone.
issues_refresh() {
  local open id url state
  open=$(hbd list -l gh-issue -s open -n 0 --json 2> /dev/null || echo '[]')
  jq -r '.[] | select(.external_ref) | "\(.id) \(.external_ref)"' <<< "$open" |
    while read -r id url; do
      state=$(gh issue view "$url" --json state -q .state 2> /dev/null) || continue
      if [[ "$state" != "OPEN" ]]; then
        hbd close "$id" -r "Closed on GitHub ($state): $url" > /dev/null && log "closed $id: $url is $state"
      fi
    done
}

cmd_issues() {
  ensure_path
  need gh jq bd
  need_hub
  case "${1:-}" in
    "") issues_assigned "" ;;
    --import) issues_assigned 1 ;;
    --refresh) issues_refresh ;;
    *) die "issues: unknown option $1 (--import | --refresh)" ;;
  esac
}

# ─── cloud: hand a bead to a Claude Code cloud session ────────────────────────
# `claude --cloud "<task>"` is INTERACTIVE ONLY in v2.1.317: refused under -p,
# from scripts, and so from Claude's own Bash tool. A human therefore runs
# `hub cloud <id>` in a terminal. The link back is a `Bead: <id>` line the
# brief asks for in the draft PR's body; cloud_refresh (no LLM, every
# dispatcher cycle) finds that PR, closes the bead and gates its dependents.
# A cloud session loads only what the repo commits (no ~/.claude skills or
# agents), so the brief has to carry everything.

bead_json() { hbd show "$1" --json 2> /dev/null | jq -c 'if type == "array" then .[0] else . end'; }

bead_repo() { jq -r '(.labels // []) | map(select(startswith("repo:"))) | first // "" | ltrimstr("repo:") | ascii_downcase' <<< "$1"; }

# True when one line of a PR body, trimmed, starts with $2 (case-insensitive).
# Line by line on purpose: jq's multiline regex flags differ between versions.
body_has_line() {
  jq -e --arg p "$2" '.body // "" | split("\n") | map(gsub("^\\s+|\\s+$"; "") | ascii_downcase)
    | any(startswith($p | ascii_downcase))' <<< "$1" > /dev/null
}

cloud_brief() {
  jq -r '
    def repo: ((.labels // []) | map(select(startswith("repo:"))) | first // "") | ltrimstr("repo:");
    "Task from the beads hub: \(.id) — \(.title)\n\n"
    + ((.description // "") | if . == "" then "(No description: work from the title.)" else . end) + "\n"
    + (if (.notes // "") != "" then "\nNotes from earlier attempts:\n\(.notes)\n" else "" end)
    + "\nHow to work:\n"
    + "- Repository: \(repo). You start on a clean branch made from the default branch for this task. Stay on it.\n"
    + "- Follow the CLAUDE.md and conventions of this repository. Run its tests, linters and build before you finish.\n"
    + "- Commit, push this branch, then open a DRAFT pull request with `gh pr create --draft`.\n"
    + "- The pull request body MUST contain this exact line: Bead: \(.id)\n"
    + (if (.external_ref // "") | test("^https://github.com/.+/issues/[0-9]+$")
       then "- The pull request body must also contain the line: Closes \(.external_ref)\n" else "" end)
    + "- If you cannot finish the task as described, still open the draft pull request, and put a line\n"
    + "  `Status: blocked — <what is missing>` in its body.\n"
    + "- Never merge, never mark the pull request ready for review, never force-push, never push to any other branch."
  ' <<< "$1"
}

# Where to launch from: your own clone (found under HUB_REPO_ROOTS), else a
# cached partial clone. The cloud session clones from GitHub regardless; the
# local copy only creates the bd/<id> branch and gives `claude --cloud` a repo
# to start in, so it needs no checkout of yours.
cloud_repo_path() {
  local path
  path=$(resolve_repo "$1" || true)
  [[ -z "$path" && -e "$CACHE/repos/$1/.git" ]] && path="$CACHE/repos/$1"
  printf '%s\n' "$path"
}

# Run `claude --cloud <brief> [extra flags]` from worktree $1, recording the
# terminal to $2 with script(1) so the printed session link can be read back.
# Not `| tee`: that makes stdout a pipe, and an interactive-only command may then
# refuse. BSD (macOS) and util-linux script(1) take different arguments.
cloud_exec() {
  local wt="$1" transcript="$2" cli="$3" brief="$4"
  shift 4
  : > "$transcript"
  if [[ "$(uname)" == "Darwin" ]]; then
    (cd "$wt" && script -q "$transcript" "$cli" --cloud "$brief" "$@")
  elif script --version 2> /dev/null | grep -q util-linux; then
    (cd "$wt" && script -q -e -c "$(printf '%q ' "$cli" --cloud "$brief" "$@")" "$transcript")
  else
    (cd "$wt" && "$cli" --cloud "$brief" "$@")
  fi
}

cloud_launch() {
  local id="$1" dry="${2:-}" bead slug path wt branch base brief
  bead=$(bead_json "$id")
  [[ -n "$bead" && "$bead" != "null" ]] || die "no bead $id in the hub"
  [[ "$(jq -r .status <<< "$bead")" != "closed" ]] || die "$id is already closed"
  slug=$(bead_repo "$bead")
  [[ -n "$slug" ]] || die "$id has no repo label; add one: bdh update $id --add-label repo:<owner>/<name>"
  path=$(cloud_repo_path "$slug")
  if [[ -n "$path" ]]; then
    git -C "$path" remote get-url origin 2> /dev/null | grep -q 'github\.com' ||
      die "$slug is not on GitHub, and cloud sessions clone from GitHub"
  fi
  wt="$CACHE/cloud/$id"
  branch="bd/$id"
  brief=$(cloud_brief "$bead")

  if [[ -n "$dry" ]]; then
    local from="use $path"
    [[ -n "$path" ]] || from="clone $slug to $CACHE/repos/$slug"
    log "dry run. Would: $from, worktree $wt on $branch"
    log "from origin's default branch, push $branch, claim $id and label it cloud, then run \`claude --cloud\` with:"
    printf '%s\n' "$brief"
    return 0
  fi
  [[ -t 0 && -t 1 ]] ||
    die "run this in a terminal: \`claude --cloud\` is interactive-only, so neither a script nor Claude can start it"
  need claude

  if [[ -z "$path" ]]; then
    need gh
    path="$CACHE/repos/$slug"
    log "no clone of $slug under $HUB_REPO_ROOTS; making a lightweight one at $path"
    mkdir -p "${path%/*}"
    # Partial clone: full history, file contents fetched on demand. Fast even
    # for big repos, and enough to branch from.
    gh repo clone "$slug" "$path" -- -q --filter=blob:none || die "could not clone $slug (no access, or not on GitHub)"
  fi

  git -C "$path" fetch -q origin
  git -C "$path" remote set-head origin -a > /dev/null 2>&1 || true
  base=$(git -C "$path" symbolic-ref --short refs/remotes/origin/HEAD) || die "cannot find origin's default branch in $path"
  if [[ ! -e "$wt" ]]; then
    mkdir -p "${wt%/*}"
    if git -C "$path" show-ref --verify --quiet "refs/heads/$branch"; then
      git -C "$path" worktree add -q "$wt" "$branch"
    else
      git -C "$path" worktree add -q -b "$branch" "$wt" "$base"
    fi
  fi
  # The cloud session clones the GitHub remote at the CURRENT branch, so the
  # branch must exist there; otherwise it silently starts from another commit.
  git -C "$wt" push -q -u origin "$branch" || die "could not push $branch to $slug"
  hbd update "$id" --claim > /dev/null || die "could not claim $id (someone else holds it?)"
  hbd update "$id" --add-label cloud --append-notes "cloud launched $(date '+%F %H:%M') from $branch" > /dev/null
  hbd dolt push > /dev/null 2>&1 || true
  log "starting a cloud session for $id from $branch. It keeps running if you close this terminal."

  # cloud_exec records the terminal so the "View: <session URL>" line can be
  # saved on the bead.
  local cli="${HUB_CLAUDE_BIN:-claude}" transcript rc=0 session mode="${HUB_CLOUD_PERMISSION_MODE-auto}" asked=""
  mkdir -p "$STATE/cloud"
  transcript="$STATE/cloud/$id.log"

  # Ask for Auto mode, or the session starts in Accept edits and then sits at
  # its first `git push` / `gh pr create`, waiting for an approval nobody gives.
  # UNVERIFIED: the docs say a cloud session's mode comes from the claude.ai mode
  # dropdown and never say whether `--cloud` honours `--permission-mode`. Repo
  # settings can't do it (`defaultMode: auto` is ignored from project files) and
  # user settings never reach the cloud. So try the flag, and if a run with it
  # fails without creating a session, retry once without it.
  # HUB_CLOUD_PERMISSION_MODE= (empty) disables the flag.
  if [[ -n "$mode" ]]; then
    asked="$mode"
    cloud_exec "$wt" "$transcript" "$cli" "$brief" --permission-mode "$mode" || rc=$?
    session=$(grep -a -o -E 'https://claude\.ai/code/session_[A-Za-z0-9_-]+' "$transcript" 2> /dev/null | head -1 || true)
    if [[ -z "$session" ]] && ((rc != 0)); then
      log "starting with --permission-mode $mode failed; retrying without it"
      asked=""
      rc=0
    fi
  fi
  if [[ -z "$asked" && -z "${session:-}" ]]; then
    cloud_exec "$wt" "$transcript" "$cli" "$brief" || rc=$?
    session=$(grep -a -o -E 'https://claude\.ai/code/session_[A-Za-z0-9_-]+' "$transcript" 2> /dev/null | head -1 || true)
  fi
  rm -f "$transcript"

  if [[ -n "$session" ]]; then
    hbd update "$id" --append-notes "cloud session: $session" > /dev/null
    hbd dolt push > /dev/null 2>&1 || true
    log "saved the session link on $id: $session"
    if [[ -n "$asked" ]]; then
      log "asked for $asked mode. Check the mode on the session page: if it says Accept edits, switch it to Auto,"
      log "or the session will stop at git push. (Whether --cloud honours the flag is not documented.)"
    else
      log "the session started in its default mode. Open the link and switch the mode to Auto,"
      log "or it will stop at git push waiting for your approval."
    fi
  elif ((rc != 0)); then
    # Nothing started: release the claim so it shows as waiting again.
    hbd update "$id" -a "" --status open --append-notes "cloud launch failed $(date '+%F %H:%M') (exit $rc)" > /dev/null
    hbd dolt push > /dev/null 2>&1 || true
    die "the cloud session did not start (exit $rc); $id is back to waiting. Fix the error above, then run: hub cloud $id"
  else
    log "no session link in the output; add it by hand: bdh update $id --append-notes \"cloud session: <url>\""
  fi
  return "$rc"
}

# "YYYY-MM-DD HH:MM" (local) -> epoch seconds. BSD and GNU date differ.
epoch_of() {
  if is_bsd_date; then date -j -f '%F %H:%M' "$1" +%s 2> /dev/null; else date -d "$1" +%s 2> /dev/null; fi
}

# One row per open or running cloud bead: id, status, minutes since the last
# launch (empty if unknown), session link, title. Fields are separated by \x1f,
# not tabs: IFS collapses runs of whitespace, so an empty field would shift
# every field after it.
cloud_rows() {
  local now id status launched session title mins t
  now=$(date +%s)
  hbd list -l cloud -n 0 --json 2> /dev/null | jq -r '.[] | [.id, .status,
      ((.notes // "") | [scan("cloud launched ([0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2})")] | (last // [""]) | .[0]),
      ((.notes // "") | [scan("cloud session: (https://[^[:space:]]+)")] | (last // [""]) | .[0]),
      .title] | join("\u001f")' |
    while IFS=$'\x1f' read -r id status launched session title; do
      mins=""
      if [[ -n "$launched" ]] && t=$(epoch_of "$launched"); then mins=$(((now - t) / 60)); fi
      printf '%s\x1f%s\x1f%s\x1f%s\x1f%s\n' "$id" "$status" "$mins" "$session" "$title"
    done
}

cloud_list() {
  local rows id status mins session title label age any_wait="" any_stale=""
  rows=$(cloud_rows)
  if [[ -z "$rows" ]]; then
    log "no cloud beads"
    return 0
  fi
  while IFS=$'\x1f' read -r id status mins session title; do
    if [[ "$status" != "in_progress" ]]; then
      printf '  waiting   %s  %s\n' "$id" "$title"
      any_wait=1
      continue
    fi
    label="running"
    age="age unknown"
    if [[ -n "$mins" ]]; then
      age="$((mins / 60))h $((mins % 60))m"
      if ((mins >= HUB_CLOUD_STALE_HOURS * 60)); then
        label="STALE"
        any_stale=1
      fi
    fi
    printf '  %-8s  %s  %s  (%s)\n' "$label" "$id" "$title" "$age"
    [[ -n "$session" ]] && printf '            %s\n' "$session"
  done <<< "$rows"
  [[ -n "$any_wait" ]] && log "launch a waiting one from a terminal: hub cloud <id>"
  [[ -n "$any_stale" ]] &&
    log "no PR after ${HUB_CLOUD_STALE_HOURS}h: open the session link. It is usually waiting for an approval, or cannot push to GitHub."
  return 0
}

# Close in-progress cloud beads whose draft PR has appeared (`Bead: <id>` in its
# body), gate their dependents on that PR, and drop the launch worktree. A PR
# saying `Status: blocked` hands the bead back to you instead.
cloud_refresh() {
  local running
  running=$(hbd list -l cloud -s in_progress -n 0 --json 2> /dev/null || echo '[]')
  jq -c '.[]' <<< "$running" | while read -r bead; do
    local id slug pr url path d
    id=$(jq -r .id <<< "$bead")
    slug=$(bead_repo "$bead")
    [[ -n "$slug" ]] || continue
    pr=$(gh pr list --repo "$slug" --state all --search "\"Bead: $id\" in:body" \
      --json url,body,state --limit 10 2> /dev/null |
      jq -c --arg m "bead: $id" '[.[] | select(.body // "" | split("\n")
        | map(gsub("^\\s+|\\s+$"; "") | ascii_downcase) | index($m))] | first // empty')
    [[ -n "$pr" ]] || continue
    url=$(jq -r .url <<< "$pr")
    if body_has_line "$pr" "status: blocked"; then
      hbd update "$id" --append-notes "cloud: came back blocked, see $url" \
        --remove-label cloud --add-label human -a "" --status open > /dev/null
      log "$id came back blocked from the cloud ($url); now labelled human"
    else
      hbd close "$id" -r "Cloud draft PR: $url" > /dev/null
      hbd dep list "$id" --direction up --json 2> /dev/null | jq -r '.[] | select(.status != "closed") | .id' |
        while read -r d; do
          hbd gate create --type=gh:pr --await-id "$url" --blocks "$d" --reason "Waits for $url to merge" > /dev/null &&
            log "gated $d on $url"
        done
      log "closed $id: $url"
    fi
    path=$(cloud_repo_path "$slug")
    if [[ -n "$path" && -d "$CACHE/cloud/$id" ]]; then
      git -C "$path" worktree remove --force "$CACHE/cloud/$id" 2> /dev/null || true
    fi
  done
}

cmd_cloud() {
  ensure_path
  need bd jq git
  need_hub
  case "${1:-}" in
    "") cloud_list ;;
    --refresh)
      need gh
      cloud_refresh
      ;;
    -*) die "cloud: unknown option $1 (--refresh, or a bead id)" ;;
    *)
      local dry=""
      [[ "${2:-}" == "--dry-run" ]] && dry=1
      cloud_launch "$1" "$dry"
      ;;
  esac
}

# ─── ui: look at the hub ──────────────────────────────────────────────────────
# beads_viewer (bv) re-exports from bd on every launch, so it is never stale.
# NEVER `bv --pages`: that wizard deploys the site to public hosting, which
# would publish every bead in the hub.
cmd_ui() {
  ensure_path
  need bv
  need_hub
  if [[ "${1:-}" != "--web" ]]; then
    exec bv --db "$HUB_DIR/.beads"
  fi
  local site="$CACHE/pages"
  mkdir -p "$site"
  bv --db "$HUB_DIR/.beads" --export-pages "$site" --pages-title "Hub (${HUB_WORKSPACE:-?})" > /dev/null
  # Regenerate on every bead change; preview live-reloads. Both stop together.
  # UI_WATCHER is global on purpose: the EXIT trap runs after this function
  # has returned, when a local would already be gone (and kill would get "").
  bv --db "$HUB_DIR/.beads" --export-pages "$site" --watch-export > /dev/null 2>&1 &
  UI_WATCHER=$!
  trap 'kill "$UI_WATCHER" 2> /dev/null' EXIT INT TERM
  log "serving $site on localhost (Ctrl-C to stop)"
  bv --db "$HUB_DIR/.beads" --preview-pages "$site"
}

# ─── dispatch: work agent-ok beads unattended ─────────────────────────────────
within_hours() {
  local d h
  d=$(date +%u)
  h=$((10#$(date +%H)))
  ((d >= ${HUB_DISPATCH_DAYS%-*} && d <= ${HUB_DISPATCH_DAYS#*-})) || return 1
  ((h >= 10#${HUB_DISPATCH_HOURS%-*} && h < 10#${HUB_DISPATCH_HOURS#*-}))
}

# Local clone for an owner/name slug: a cached origin-URL scan of HUB_REPO_ROOTS.
resolve_repo() {
  local slug="$1" cache="$CACHE/repos.tsv" path="" g d url root
  [[ -r "$cache" ]] && path=$(awk -F'\t' -v s="$slug" '$1 == s { print $2; exit }' "$cache")
  if [[ -z "$path" || ! -e "$path/.git" ]]; then
    mkdir -p "$CACHE"
    for root in $HUB_REPO_ROOTS; do
      [[ -d "$root" ]] || continue
      find "$root" -maxdepth 4 -name .git -prune 2> /dev/null | while read -r g; do
        d="${g%/.git}"
        url=$(git -C "$d" remote get-url origin 2> /dev/null) || continue
        printf '%s\t%s\n' "$(slug_of "$url")" "$d"
      done
    done > "$cache.new"
    mv "$cache.new" "$cache"
    path=$(awk -F'\t' -v s="$slug" '$1 == s { print $2; exit }' "$cache")
  fi
  [[ -n "$path" ]] && printf '%s\n' "$path"
}

dispatch_run() {
  local dry="" force=""
  while (($#)); do
    case "$1" in
      --dry-run) dry=1 ;;
      --force) force=1 ;; # ignore the hours window, for a manual run
      *) die "dispatch run: unknown option $1" ;;
    esac
    shift
  done
  ensure_path
  need bd jq git
  need_hub
  mkdir -p "$STATE/runs" "$STATE/logs" "$CACHE/wt"

  if [[ -e "$STATE/paused" ]]; then
    log "paused (hub dispatch resume)"
    return 0
  fi
  if [[ -z "$dry$force" ]] && ! within_hours; then
    log "outside dispatch hours ($HUB_DISPATCH_DAYS / $HUB_DISPATCH_HOURS)"
    return 0
  fi

  # launchd never overlaps one job with itself, but a manual run could.
  # (macOS has no flock, hence mkdir.) A lock whose pid is gone is stale.
  # Global, not local: the EXIT trap fires after this function has returned.
  DISPATCH_LOCK="$STATE/dispatch.lock"
  if ! mkdir "$DISPATCH_LOCK" 2> /dev/null; then
    if kill -0 "$(cat "$DISPATCH_LOCK/pid" 2> /dev/null)" 2> /dev/null; then
      log "another dispatch is running"
      return 0
    fi
    rm -rf "$DISPATCH_LOCK"
    mkdir "$DISPATCH_LOCK"
  fi
  echo $$ > "$DISPATCH_LOCK/pid"
  trap 'rm -rf "$DISPATCH_LOCK"' EXIT

  hbd dolt pull > /dev/null 2>&1 || log "pull failed; dispatching from the local copy"

  # Keep GitHub issues in step before looking for work: import new issues
  # assigned to you (never agent-ok: you still choose what gets dispatched) and
  # close beads whose issue was closed upstream, so nothing already fixed is
  # worked. No LLM involved. HUB_IMPORT_ISSUES=0 in env.local turns it off.
  if [[ "${HUB_IMPORT_ISSUES:-1}" == 1 && -z "$dry" ]] && command -v gh > /dev/null 2>&1; then
    issues_refresh || log "issue refresh failed"
    issues_assigned 1 || log "issue import failed"
  fi
  # Close cloud beads whose draft PR has appeared, so their dependents get gated
  # on that PR. Independent of HUB_IMPORT_ISSUES; also no LLM.
  if [[ -z "$dry" ]] && command -v gh > /dev/null 2>&1; then
    cloud_refresh || log "cloud refresh failed"
  fi

  local today runs
  today=$(date +%F)
  runs=$(find "$STATE/runs" -name "$today-*" 2> /dev/null | wc -l | tr -d ' ')
  if ((runs >= HUB_DISPATCH_MAX_RUNS)); then
    log "daily cap reached ($runs/$HUB_DISPATCH_MAX_RUNS runs)"
    return 0
  fi

  hbd gate check > /dev/null 2>&1 || log "gate check failed (is gh logged in?)"

  # Opt-in only: agent-ok, and never anything marked human or triage. cloud
  # beads are never worked locally: you launch them with `hub cloud <id>`.
  local ready
  ready=$(hbd ready --json -l agent-ok -n 50 2> /dev/null | jq -c '
    [.[] | select((.labels // []) | (index("human") or index("triage") or index("cloud")) | not)]')
  if [[ "$(jq length <<< "$ready")" -eq 0 ]]; then
    log "nothing ready"
    return 0
  fi

  # Attach each bead's local clone; skip (once-noted) beads with none.
  local batch='[]' bead id slug path notes
  local -a dirs=()
  while read -r bead; do
    id=$(jq -r .id <<< "$bead")
    slug=$(jq -r '(.labels // []) | map(select(startswith("repo:"))) | first // "" | ltrimstr("repo:") | ascii_downcase' <<< "$bead")
    if [[ -z "$slug" ]]; then
      log "$id has no repo:<owner>/<name> label; skipped"
      continue
    fi
    path=$(resolve_repo "$slug" || true)
    if [[ -z "$path" ]]; then
      notes=$(jq -r '.notes // ""' <<< "$bead")
      [[ "$notes" == *"no local clone"* ]] ||
        hbd update "$id" --append-notes "dispatch: no local clone of $slug under $HUB_REPO_ROOTS; skipped" > /dev/null 2>&1 || true
      log "$id: no local clone of $slug; skipped"
      continue
    fi
    batch=$(jq -c --argjson b "$bead" --arg p "$path" '. + [$b + {path: $p}]' <<< "$batch")
    dirs+=(--add-dir "$path")
    (($(jq length <<< "$batch") < HUB_DISPATCH_BATCH)) || break
  done < <(jq -c '.[]' <<< "$ready")

  if [[ "$(jq length <<< "$batch")" -eq 0 ]]; then
    log "no dispatchable beads"
    return 0
  fi
  if [[ -n "$dry" ]]; then
    log "dry run — would dispatch:"
    jq -r '.[] | "  \(.id)  \(.title)  →  \(.path)"' <<< "$batch"
    printf '  claude args: %s\n' "${dirs[*]} --add-dir $CACHE/wt"
    return 0
  fi

  local stamp logf rc=0
  stamp="$today-$(date +%H%M%S)"
  touch "$STATE/runs/$stamp"
  logf="$STATE/logs/$stamp.json"
  log "dispatching $(jq length <<< "$batch") bead(s); log: $logf"

  # The prompt goes on stdin: --add-dir and --disallowedTools are variadic and
  # would swallow a trailing positional prompt. cwd is the hub, so its
  # SessionStart hook primes the session. --strict-mcp-config drops every MCP
  # server, claude.ai connectors included (verified: mcp_servers = []).
  # The allow rules pre-approve exactly the draft-PR path (push bd/<id>, open
  # a draft) so auto mode's classifier cannot strand a finished bead; with
  # --permission-prompts none there is nobody to approve anything else.
  printf 'Load the `hub` skill and follow its dispatch mode for these ready beads. Each bead has a "path": the local clone to branch from. Beads: %s\n' "$batch" |
    (cd "$HUB_DIR" && BEADS_ACTOR=agent:dispatch claude -p --agent orchestrator \
      --permission-mode auto --permission-prompts none --strict-mcp-config \
      --max-budget-usd "$HUB_DISPATCH_BUDGET_USD" --max-turns "$HUB_DISPATCH_MAX_TURNS" \
      --output-format json \
      --allowedTools "Bash(bdh *)" "Bash(git -C * push -u origin bd/*)" "Bash(git push -u origin bd/*)" \
      "Bash(gh pr create --draft *)" \
      --disallowedTools "Bash(gh pr merge *)" "Bash(gh pr ready *)" "Bash(git push --force *)" \
      "Bash(git push -f *)" "Bash(git push --force-with-lease *)" \
      "${dirs[@]}" --add-dir "$CACHE/wt") > "$logf" 2> "${logf%.json}.err" || rc=$?

  hbd dolt push > /dev/null 2>&1 || log "push failed; the next run retries"

  local summary
  summary=$(jq -r '"\(.subtype // "error") · ~$\((.total_cost_usd // 0) * 100 | round / 100) · \((.result // "") | tostring | .[0:140])"' "$logf" 2> /dev/null ||
    echo "claude exited $rc; see ${logf%.json}.err")
  log "$summary"
  notify "hub dispatch" "$summary"
}

dispatch_status() {
  local today runs cost_today cost_week last
  today=$(date +%F)
  runs=$(find "$STATE/runs" -name "$today-*" 2> /dev/null | wc -l | tr -d ' ')
  printf 'paused:      %s\n' "$([[ -e "$STATE/paused" ]] && echo yes || echo no)"
  printf 'runs today:  %s / %s\n' "$runs" "$HUB_DISPATCH_MAX_RUNS"
  printf 'guardrails:  ~$%s/run, %s turns, %s beads/run, days %s, hours %s\n' \
    "$HUB_DISPATCH_BUDGET_USD" "$HUB_DISPATCH_MAX_TURNS" "$HUB_DISPATCH_BATCH" \
    "$HUB_DISPATCH_DAYS" "$HUB_DISPATCH_HOURS"
  if command -v launchctl > /dev/null 2>&1; then
    printf 'launchd:     %s\n' "$(launchctl print "gui/$(id -u)/$LAUNCHD_DISPATCH" > /dev/null 2>&1 && echo loaded || echo "not loaded")"
  fi
  # shellcheck disable=SC2016
  cost_today=$(find "$STATE/logs" -name "$today-*.json" -exec cat {} + 2> /dev/null | jq -s 'map(.total_cost_usd // 0) | add // 0 | . * 100 | round / 100' 2> /dev/null || echo 0)
  cost_week=$(find "$STATE/logs" -name '*.json' -mtime -7 -exec cat {} + 2> /dev/null | jq -s 'map(.total_cost_usd // 0) | add // 0 | . * 100 | round / 100' 2> /dev/null || echo 0)
  printf 'est. cost:   ~$%s today, ~$%s last 7 days\n' "$cost_today" "$cost_week"
  local crow cwait=0 crun=0 cstale=0 cid cstatus cmins
  while IFS=$'\x1f' read -r cid cstatus cmins _; do
    [[ -n "$cid" ]] || continue
    if [[ "$cstatus" != "in_progress" ]]; then
      cwait=$((cwait + 1))
    else
      crun=$((crun + 1))
      [[ -n "$cmins" ]] && ((cmins >= HUB_CLOUD_STALE_HOURS * 60)) && cstale=$((cstale + 1))
    fi
  done <<< "$(cloud_rows)"
  crow="$cwait waiting to launch, $crun running"
  ((cstale > 0)) && crow="$crow, $cstale with no PR after ${HUB_CLOUD_STALE_HOURS}h (see hub cloud)"
  printf 'cloud:       %s\n' "$crow"
  last=$(find "$STATE/logs" -name '*.json' 2> /dev/null | sort | tail -1)
  if [[ -n "$last" ]]; then
    printf 'last run:    %s — %s\n' "$(basename "$last" .json)" \
      "$(jq -r '"\(.subtype // "?") · \((.result // "") | tostring | .[0:120])"' "$last" 2> /dev/null || echo unreadable)"
  fi
}

dispatch_approve() {
  local id="${1:?usage: hub dispatch approve <bead-id>}" gates g
  ensure_path
  need_hub
  hbd update "$id" --add-label fable-ok > /dev/null
  gates=$(hbd show "$id" --json | jq -r '(if type == "array" then .[0] else . end) | .dependencies // []
    | .[] | select(.issue_type == "gate" and .await_type == "human" and .status != "closed") | .id')
  for g in $gates; do
    hbd gate resolve "$g" -r "Fable approved by $(git config --global user.name)" > /dev/null
    log "resolved $g"
  done
  log "$id labelled fable-ok; the next dispatch run may use Fable on it"
}

cmd_dispatch() {
  local sub="${1:-status}"
  shift || true
  case "$sub" in
    run) dispatch_run "$@" ;;
    pause)
      mkdir -p "$STATE"
      touch "$STATE/paused"
      log "dispatcher paused"
      ;;
    resume)
      rm -f "$STATE/paused"
      log "dispatcher resumed"
      ;;
    status) dispatch_status ;;
    approve) dispatch_approve "$@" ;;
    *) die "dispatch: unknown subcommand $sub (run|pause|resume|status|approve)" ;;
  esac
}

usage() {
  cat << 'EOF'
hub — beads hub toolkit (bd against ~/hub without cd: use `bdh`)

  hub init                      create this workspace's hub + private GitHub repo (once, ever)
  hub bootstrap                 clone the existing hub onto this machine (chezmoi runs this)
  hub report [--raw] [--date D] build today's summary draft (--raw: skip the Sonnet polish)
  hub report show               print the latest draft and copy it to the clipboard
  hub issue <url|o/r#N> [--agent-ok]  import one GitHub issue as a bead
  hub issues [--import]         open issues assigned to you that aren't in the hub yet
  hub issues --refresh          close beads whose GitHub issue was closed
  hub ui [--web]                browse the hub: terminal UI, or a live page on localhost
  hub cloud                     cloud beads: waiting to launch, and running
  hub cloud <id> [--dry-run]    start a Claude Code cloud session for a bead (in a terminal)
  hub cloud --refresh           close cloud beads whose draft PR has appeared
  hub dispatch run [--dry-run]  work ready agent-ok beads unattended (launchd runs this)
  hub dispatch pause|resume     kill switch
  hub dispatch status           runs today, estimated cost, last result
  hub dispatch approve <id>     allow Fable on a bead and lift its human gate

Shell helpers: did [-r owner/name] "text" (log your own work), todo [-r owner/name] ["text"] (your to-dos).
Without -r they tag the git repo you are in; text starting with - goes after --.
Overrides: ~/.config/hub/env.local, e.g. HUB_DISPATCH_BUDGET_USD=1
EOF
}

case "${1:-help}" in
  init) cmd_init ;;
  bootstrap) cmd_bootstrap ;;
  report)
    shift
    cmd_report "$@"
    ;;
  dispatch)
    shift
    cmd_dispatch "$@"
    ;;
  issue)
    shift
    cmd_issue "$@"
    ;;
  issues)
    shift
    cmd_issues "$@"
    ;;
  ui)
    shift
    cmd_ui "$@"
    ;;
  cloud)
    shift
    cmd_cloud "$@"
    ;;
  help | -h | --help) usage ;;
  *)
    usage >&2
    exit 2
    ;;
esac
