{{/*
   ~/.gitconfig — rendered from chezmoi data, so identity is never committed.
   This is a template, so it is materialised as a real file rather than a
   symlink (symlink mode deliberately exempts templates).

   Do NOT also create ~/.config/git/config: when ~/.gitconfig exists, git
   ignores the XDG config file entirely and it would be silently dead.
   ~/.config/git/ignore is unaffected and still works.
*/}}
[user]
	name = {{ .name | quote }}
	email = {{ .email | quote }}

[init]
	defaultBranch = main

[core]
	editor = nvim
	excludesFile = ~/.config/git/ignore
	pager = {{ if lookPath "delta" }}delta{{ else }}less -FRX{{ end }}

[url "git@github.com:{{ .workOrg }}/"]
	insteadOf = https://github.com/{{ .workOrg }}/

[push]
	default = current
	autoSetupRemote = true
	followTags = true

[pull]
	rebase = true

[rebase]
	autoStash = true
	autosquash = true

[fetch]
	prune = true
	pruneTags = true

[merge]
	conflictstyle = zdiff3

[diff]
	colorMoved = default
	algorithm = histogram
	renames = copies

[branch]
	sort = -committerdate

[log]
	date = iso

[rerere]
	enabled = true

[help]
	autocorrect = prompt

[transfer]
	fsckObjects = true

[column]
	ui = auto
{{ if lookPath "delta" }}
[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true
	hyperlinks = true
{{ end }}
{{- if .workEmail }}
{{/*
   Work identity, selected by REMOTE URL rather than by directory.
   `hasconfig:remote.*.url` needs git >= 2.36.

   A gitdir: condition would be wrong here: webtize repos live in BOTH ~/Herd
   and ~/workspace, and ~/workspace also holds personal repos
   (my_first_laravel_app), so no directory prefix cleanly separates them.
   Matching the remote gets it right wherever the repo happens to sit on disk.

   Both hosts and both URL forms are covered — the audit found webtize repos on
   github.com (SSH) and bitbucket.org (SSH), and the insteadOf rule above can
   rewrite HTTPS to SSH.
*/}}
[includeIf "hasconfig:remote.*.url:git@github.com:{{ .workOrg }}/**"]
	path = ~/.config/git/config.work
[includeIf "hasconfig:remote.*.url:https://github.com/{{ .workOrg }}/**"]
	path = ~/.config/git/config.work
[includeIf "hasconfig:remote.*.url:git@bitbucket.org:{{ .workOrg }}/**"]
	path = ~/.config/git/config.work
[includeIf "hasconfig:remote.*.url:https://bitbucket.org/{{ .workOrg }}/**"]
	path = ~/.config/git/config.work
{{- end }}

{{/*
   GitHub credentials via the gh CLI.

   `gh auth setup-git` writes exactly this block into ~/.gitconfig — but that
   file is managed here, so the next `chezmoi apply` would delete it and the
   next push would fail with "could not read Username for https://github.com".
   Keeping it in the source is what makes it survive.

   Two deliberate differences from what setup-git generates:

   1. Bare `gh`, not the absolute path. setup-git hardcodes the resolved binary,
      which on a mise-managed machine is a VERSION-PINNED path like
      ~/.local/share/mise/installs/gh/2.101.0/gh_.../bin/gh. That breaks the
      moment mise upgrades gh. Resolving through PATH has no such problem.

   2. The empty `helper =` line is kept. It is not noise: git ACCUMULATES
      credential helpers, and an empty value resets the list, so a helper
      inherited from /etc/gitconfig or a system keyring cannot shadow gh.

   Only applies to github.com and gist.github.com, so other hosts keep whatever
   helper they already use. Harmless when gh is absent — git falls through to
   its normal prompting.
*/}}
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
