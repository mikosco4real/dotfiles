#!/usr/bin/env bash
# Clone this machine's beads hub to ~/hub and `bd bootstrap` its database.
# All of the logic lives in ~/.local/bin/hub (`hub bootstrap`), which is also
# runnable by hand; this script only decides whether to call it.
#
# after_, because it runs the deployed ~/.local/bin/hub and reads the deployed
# ~/.config/hub/env. run_onchange_ keyed on the remote below, so it re-runs when
# hubRemote changes (e.g. set for the first time by `chezmoi apply --init`).
# Once ~/hub exists, `hub bootstrap` is a no-op, so re-runs are harmless.
#
# hubRemote: {{ get . "hubRemote" | default "" }}
set -euo pipefail

log() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }

{{ if env "CI" -}}
# The container harness has no GitHub credentials and no hub to clone.
log "CI detected; skipping beads hub bootstrap"
exit 0
{{ end -}}

{{ if not (get . "hubRemote") -}}
log "no hubRemote for this machine; skipping beads hub"
exit 0
{{ end -}}

HUB="$HOME/.local/bin/hub"
if [[ ! -x "$HUB" ]]; then
  log "WARNING: $HUB missing; skipping beads hub bootstrap"
  exit 0
fi

# Non-fatal: an unreachable remote or a missing bd must not abort the apply.
"$HUB" bootstrap || log "WARNING: hub bootstrap failed; run \`hub bootstrap\` by hand to see why"
