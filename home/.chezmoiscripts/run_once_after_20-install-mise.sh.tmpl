#!/usr/bin/env bash
# Ensure mise exists. after_ so the shell config that activates it is already in
# place. Normally the Brewfile has installed it; this is the fallback for a
# machine with no working Homebrew.
set -euo pipefail

if command -v mise >/dev/null 2>&1 || [[ -x "$HOME/.local/bin/mise" ]]; then
  exit 0
fi

printf '\033[1;34m==>\033[0m %s\n' "Installing mise via https://mise.run"
curl -fsSL https://mise.run | sh
