{{ if and (eq .chezmoi.os "darwin") (get . "hubDispatcher") -}}
#!/usr/bin/env bash
# (Re)load the beads hub dispatcher's launchd agent on the dispatcher machine.
# launchd reads a plist only when the job is bootstrapped, so a changed plist
# needs bootout + bootstrap. run_onchange_, keyed on the plist's content:
#
# hub-dispatch.plist: {{ include "private_Library/LaunchAgents/dev.dotfiles.hub-dispatch.plist.tmpl" | sha256sum }}
#
# The daily report has no agent of its own any more. Its StartCalendarInterval
# job never fired (runs = 0 while the Mac was awake at 16:45), so the
# dispatcher's 30-minute cycle builds the draft instead (`maybe_daily_report` in
# ~/.local/bin/hub). Retire the old job wherever it was loaded; chezmoi no longer
# manages its plist, so remove that file too.
#
# Renders empty (and so never runs) unless this is macOS with
# hubDispatcher = true. To stop dispatching without unloading anything, use
# `hub dispatch pause`. To move the dispatcher to another machine, set
# hubDispatcher = false here (`chezmoi init`) and launchctl bootout the label.
set -euo pipefail

log() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }

{{ if env "CI" -}}
log "CI detected; not loading launchd agents"
exit 0
{{ end -}}

# launchd does not create the log directory named in StandardOutPath.
mkdir -p "$HOME/.local/state/hub"

domain="gui/$(id -u)"

old="dev.dotfiles.hub-report"
if launchctl print "$domain/$old" > /dev/null 2>&1; then
  launchctl bootout "$domain/$old" 2> /dev/null || true
  log "retired $old (the dispatcher builds the daily draft now)"
fi
rm -f "$HOME/Library/LaunchAgents/$old.plist"

label="dev.dotfiles.hub-dispatch"
plist="$HOME/Library/LaunchAgents/$label.plist"
if [[ ! -f "$plist" ]]; then
  log "WARNING: $plist missing; skipping"
  exit 0
fi
launchctl bootout "$domain/$label" 2> /dev/null || true
launchctl bootstrap "$domain" "$plist" || log "WARNING: could not load $label"
log "loaded $label"
{{ end -}}
