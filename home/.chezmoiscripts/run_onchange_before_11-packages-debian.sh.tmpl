{{ if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
# apt packages from dot_config/packages/debian.txt.
#
# debian.txt hash: {{ include "dot_config/packages/debian.txt" | sha256sum }}
set -euo pipefail

log() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }

command -v apt-get >/dev/null 2>&1 || { log "no apt-get; skipping"; exit 0; }

# The Docker test harness runs as root, where sudo may not be installed.
if [[ "$(id -u)" -eq 0 ]]; then SUDO=""; else SUDO="sudo"; fi

export DEBIAN_FRONTEND=noninteractive

PKGS=$(grep -vE '^\s*(#|$)' {{ joinPath .chezmoi.sourceDir "dot_config/packages/debian.txt" | quote }} | tr '\n' ' ')

log "apt-get install: $PKGS"
$SUDO apt-get update -qq
# -y and --no-install-recommends make this idempotent and lean; apt is a no-op
# for packages already at the right version.
# shellcheck disable=SC2086
$SUDO apt-get install -y --no-install-recommends $PKGS

{{ if .gui -}}
# ── Ghostty ───────────────────────────────────────────────────────────────────
# Ghostty upstream officially supports only building from source on Linux. The
# de-facto standard prebuilt for Debian/Ubuntu is mkasberg's PPA, which tracks
# upstream releases closely (1.3.x, matching the macOS cask).
if ! command -v ghostty >/dev/null 2>&1; then
  log "Installing Ghostty"
  if command -v add-apt-repository >/dev/null 2>&1; then
    $SUDO add-apt-repository -y ppa:mkasberg/ghostty-ubuntu || true
    $SUDO apt-get update -qq
    $SUDO apt-get install -y ghostty || \
      log "Ghostty install failed — see https://github.com/mkasberg/ghostty-ubuntu"
  else
    log "add-apt-repository unavailable; install Ghostty manually"
  fi
fi
{{ end -}}

log "apt packages done"
{{ end -}}
