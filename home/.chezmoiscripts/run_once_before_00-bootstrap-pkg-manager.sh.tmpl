#!/usr/bin/env bash
# Make a package manager exist. Runs BEFORE any file, symlink or external is
# written, because chezmoi's git-repo externals need `git`, and everything
# downstream needs brew or apt.
set -euo pipefail

log() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }

{{ if eq .chezmoi.os "darwin" -}}
if ! command -v brew >/dev/null 2>&1; then
  log "Installing Homebrew"
  NONINTERACTIVE=1 /bin/bash -c \
    "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

# Put brew on PATH for the REST OF THIS SCRIPT RUN. ~/.config/zsh/.zprofile does
# this for interactive shells, but it has not been applied yet during a before_
# script, and this process will not see it either way.
for _b in /opt/homebrew/bin/brew /usr/local/bin/brew; do
  [[ -x "$_b" ]] && eval "$("$_b" shellenv)" && break
done

# Xcode command line tools — needed to build anything from source.
if ! xcode-select -p >/dev/null 2>&1; then
  log "Requesting Xcode Command Line Tools (a GUI dialog will open)"
  xcode-select --install || true
fi
{{- end }}

{{ if eq .chezmoi.os "linux" -}}
# The Docker test harness runs as root, where sudo may not even be installed.
if [[ "$(id -u)" -eq 0 ]]; then SUDO=""; else SUDO="sudo"; fi

if command -v apt-get >/dev/null 2>&1; then
  log "Installing base packages via apt"
  export DEBIAN_FRONTEND=noninteractive
  $SUDO apt-get update -qq
  $SUDO apt-get install -y --no-install-recommends \
    build-essential procps curl file git zsh ca-certificates
else
  echo "WARNING: no apt-get found. This bootstrap supports Debian/Ubuntu only." >&2
  echo "Install git, curl, zsh and a build toolchain manually, then re-run." >&2
fi

# Homebrew-on-Linux, used as a top-up for CLI tools whose apt versions are too
# old (most importantly Neovim: Ubuntu 24.04 has 0.9.x, this config needs 0.12+).
if ! command -v brew >/dev/null 2>&1 && [[ ! -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
  log "Installing Homebrew for Linux"
  NONINTERACTIVE=1 /bin/bash -c \
    "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi
[[ -x /home/linuxbrew/.linuxbrew/bin/brew ]] && eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
{{- end }}

log "Package manager ready"
