{{ if and (eq .chezmoi.os "linux") .gui -}}
#!/usr/bin/env bash
# Rebuild the font cache after .chezmoiexternal.toml has unpacked the Nerd Fonts
# into ~/.local/share/fonts. Without this, the glyphs in starship.toml, the tmux
# theme and the terminal configs render as tofu boxes until the next login.
#
# macOS needs no equivalent — fonts arrive as Homebrew casks and are registered
# automatically.
set -euo pipefail

FONT_DIR="$HOME/.local/share/fonts"

# ── Verify what THIS repo is responsible for: the files being on disk ──────────
# Deliberately not asserting against `fc-list` here. An earlier version did, and
# it reported both fonts missing on a run where all 159 .ttf files were present
# and fontconfig later listed them correctly — querying the index in the same
# breath as rebuilding it is racy, and fontconfig's index is its business, not
# ours. File presence is the thing this script can actually guarantee.
missing=0
for family in VictorMono JetBrainsMono; do
  # Guard on the directory existing before running find. Under `set -e` with
  # pipefail, find failing on a missing path makes the whole command
  # substitution fail and aborts the script *before* the warning below can
  # print — which is exactly how this went wrong the first time.
  n=0
  if [[ -d "$FONT_DIR/$family" ]]; then
    n=$(find "$FONT_DIR/$family" -name '*.ttf' 2>/dev/null | wc -l | tr -d ' ')
  fi
  if [[ "$n" -gt 0 ]]; then
    printf '  %-16s %s .ttf files\n' "$family" "$n"
  else
    echo "  WARNING: no $family .ttf files in $FONT_DIR/$family" >&2
    echo "           Check .chezmoiexternal.toml, then re-run:" >&2
    echo "             chezmoi apply --refresh-externals" >&2
    missing=1
  fi
done

if [[ "$missing" -eq 1 ]]; then
  echo "  Skipping cache rebuild — nothing to index." >&2
  exit 0
fi

command -v fc-cache > /dev/null 2>&1 || {
  echo "  fc-cache not found (apt install fontconfig); fonts will register at next login" >&2
  exit 0
}

printf '\033[1;34m==>\033[0m %s\n' "Rebuilding font cache"
# Rebuild the whole user cache rather than just one directory, so fontconfig
# definitely picks the new families up.
fc-cache -f

# Informational only — never fails the apply. The names below are the exact
# families the configs request:
#   VictorMono Nerd Font Mono     ghostty + kitty font-family
#   JetBrainsMono Nerd Font Mono  Zed buffer_font_family
for family in "VictorMono Nerd Font Mono" "JetBrainsMono Nerd Font Mono"; do
  if fc-list : family 2>/dev/null | grep -qF "$family"; then
    echo "  registered: $family"
  else
    echo "  note: fontconfig has not indexed \"$family\" yet; it will after the next login"
  fi
done
{{ end -}}
