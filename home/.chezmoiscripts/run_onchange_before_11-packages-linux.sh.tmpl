{{ if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
# Distro packages: apt from dot_config/packages/debian.txt on Debian/Ubuntu,
# pacman from dot_config/packages/arch.txt (plus paru from arch-aur.txt) on Arch.
#
# Both manifest hashes are inlined so this re-runs when EITHER changes. The
# machine only ever consumes one of them, so it will occasionally re-run for a
# change to the other distro's list — harmless, since every branch is idempotent.
#
# debian.txt hash:   {{ include "dot_config/packages/debian.txt" | sha256sum }}
# arch.txt hash:     {{ include "dot_config/packages/arch.txt" | sha256sum }}
# arch-aur.txt hash: {{ include "dot_config/packages/arch-aur.txt" | sha256sum }}
set -euo pipefail

log() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }

# The Docker test harness runs as root, where sudo may not be installed.
if [[ "$(id -u)" -eq 0 ]]; then SUDO=""; else SUDO="sudo"; fi

# Manifests are read from the SOURCE directory, not the deployed path: this is a
# before_ script, so ~/.config/packages/ does not exist yet on a first run.
#
# `|| true` is load-bearing: grep exits 1 when nothing matches, and under
# `set -e` with pipefail that would abort the entire apply just because a
# package list happened to be all comments. An empty list should be a no-op.
read_manifest() {
  grep -vE '^\s*(#|$)' "$1" 2> /dev/null | tr '\n' ' ' || true
}

# ── Arch ──────────────────────────────────────────────────────────────────────
if command -v pacman >/dev/null 2>&1; then
  PKGLIST={{ joinPath .chezmoi.sourceDir "dot_config/packages/arch.txt" | quote }}
  PKGS=$(read_manifest "$PKGLIST")

{{ if not .gui -}}
  # Not a desktop machine: drop the GUI terminal from the list.
  PKGS=${PKGS//ghostty/}
{{ end -}}

  if [[ -z "${PKGS// /}" ]]; then
    log "no packages listed in $PKGLIST; nothing to do"
  else
    log "pacman -S: $PKGS"
    # --needed skips anything already installed, which is what makes a second
    # apply a no-op rather than a reinstall.
    # shellcheck disable=SC2086
    $SUDO pacman -Sy --needed --noconfirm $PKGS
  fi

  # ── AUR ─────────────────────────────────────────────────────────────────────
  # Skipped under CI (makepkg refuses to run as root) and when paru is absent.
  # A failure here is a warning: the AUR is unreviewed and a broken build there
  # must never take down the whole bootstrap.
  AURLIST={{ joinPath .chezmoi.sourceDir "dot_config/packages/arch-aur.txt" | quote }}
  AURPKGS=$(read_manifest "$AURLIST")

  if [[ -n "${CI:-}" ]]; then
    log "CI detected; skipping AUR packages"
  elif ! command -v paru >/dev/null 2>&1; then
    log "paru not installed; skipping AUR packages: $AURPKGS"
  elif [[ -n "${AURPKGS// /}" ]]; then
    log "paru -S: $AURPKGS"
    # shellcheck disable=SC2086
    paru -S --needed --noconfirm $AURPKGS ||
      log "WARNING: one or more AUR packages failed to build; continuing"
  fi

  log "pacman packages done"
  exit 0
fi

# ── Debian / Ubuntu ───────────────────────────────────────────────────────────
command -v apt-get >/dev/null 2>&1 || { log "neither pacman nor apt-get; skipping"; exit 0; }

export DEBIAN_FRONTEND=noninteractive

PKGLIST={{ joinPath .chezmoi.sourceDir "dot_config/packages/debian.txt" | quote }}
PKGS=$(read_manifest "$PKGLIST")

if [[ -z "${PKGS// /}" ]]; then
  log "no packages listed in $PKGLIST; nothing to do"
  exit 0
fi

log "apt-get install: $PKGS"
$SUDO apt-get update -qq
# -y and --no-install-recommends make this idempotent and lean; apt is a no-op
# for packages already at the right version.
# shellcheck disable=SC2086
$SUDO apt-get install -y --no-install-recommends $PKGS

{{ if .gui -}}
# ── Ghostty ───────────────────────────────────────────────────────────────────
# Debian only. Arch has ghostty in `extra`, so it is just another line in
# arch.txt and needs none of this.
#
# Skipped under CI: add-apt-repository is slow and unreliable in bare containers,
# and a GUI terminal is not what those runs verify.
if [[ -n "${CI:-}" ]]; then
  log "CI detected; skipping Ghostty install"
  exit 0
fi
# Ghostty upstream officially supports only building from source on Linux. The
# de-facto standard prebuilt for Debian/Ubuntu is mkasberg's PPA, which tracks
# upstream releases closely (1.3.x, matching the macOS cask).
if ! command -v ghostty >/dev/null 2>&1; then
  log "Installing Ghostty"
  if command -v add-apt-repository >/dev/null 2>&1; then
    $SUDO add-apt-repository -y ppa:mkasberg/ghostty-ubuntu || true
    $SUDO apt-get update -qq
    $SUDO apt-get install -y ghostty || \
      log "Ghostty install failed — see https://github.com/mkasberg/ghostty-ubuntu"
  else
    log "add-apt-repository unavailable; install Ghostty manually"
  fi
fi
{{ end -}}

log "apt packages done"
{{ end -}}
